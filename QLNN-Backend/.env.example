# Server
PORT=5001
NODE_ENV=development

# Database (PostgreSQL Native Độc Lập - Schema qlnn)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/qlnn_db?schema=qlnn"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/qlnn_db?schema=qlnn"

# Shared JWT Secrets (Yêu cầu chuỗi ngẫu nhiên tối thiểu 32-64 ký tự an toàn)
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_REFRESH_SECRET_AT_LEAST_32_CHARS"

# Central Auth SSO Gateway (QLCS-Backend)
AUTH_GATEWAY_URL="https://qlcs.dulieudakha.vn"

# CORS Origins (Hỗ trợ cả Web & Electron qua Cloudflare Tunnel)
CORS_ORIGIN="https://qlnn.dulieudakha.vn,https://dulieudakha.vn,http://localhost:5174"

# Phone Encryption - AES-256-GCM (64 hex chars = 32 bytes)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
PHONE_HASH_PEPPER="CHANGE_ME_phone_hash_pepper_min_32_chars"
